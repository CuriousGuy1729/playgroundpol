{
  "name": "PRISM Lab",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "PRISM Lab — open this",
      "onAutoForward": "openPreview",
      "visibility": "public",
      "protocol": "http",
      "requireLocalPort": true
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "postCreateCommand": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt && cd frontend && npm install && npm run build",
  "postStartCommand": "bash -lc 'cd \"${containerWorkspaceFolder:-.}\" && nohup bash scripts/start.sh >/tmp/prism-5173.log 2>&1 &'",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  }
}
