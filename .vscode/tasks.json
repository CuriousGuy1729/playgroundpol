{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PRISM Lab (port 5173)",
      "type": "shell",
      "command": "bash scripts/start.sh",
      "isBackground": true,
      "problemMatcher": {
        "owner": "prism",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Uvicorn running"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
