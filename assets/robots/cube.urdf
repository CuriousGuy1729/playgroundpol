<?xml version="1.0"?>
<robot name="lab_cube">
  <link name="base">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.18 0.18 0.18"/>
      </geometry>
      <material name="red">
        <color rgba="0.86 0.14 0.16 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.18 0.18 0.18"/>
      </geometry>
    </collision>
  </link>
</robot>
